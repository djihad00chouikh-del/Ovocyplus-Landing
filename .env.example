# Primary CTA destination (client replaces #buy with a real URL later)
VITE_CTA_URL=#buy

# Default locale: fr | en | ar
VITE_DEFAULT_LOCALE=fr

# Absolute site URL used by canonical links, hreflang, sitemap and social cards.
# Replace with the production domain once decided (defaults to the Cloudflare
# Pages URL used in public/robots.txt and public/sitemap.xml).
VITE_SITE_URL=https://ovocyplus.pages.dev